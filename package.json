{
  "name": "devtime-fe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "format": "prettier -c ./src/shared/configs/prettier.config.js --ignore-path ./src/shared/configs/.prettierignore --check .",
    "format:write": "prettier -c ./src/shared/configs/prettier.config.js --ignore-path ./src/shared/configs/.prettierignore --write .",
    "lint": "eslint . -c ./src/shared/configs/eslint.config.mjs --max-warnings=0",
    "lint:fix": "eslint . -c ./src/shared/configs/eslint.config.mjs --fix --max-warnings=0",
    "lint:css": "stylelint -c ./src/shared/configs/stylelint.config.mjs \"src/**/*.{css,js,jsx,ts,tsx}\" --max-warnings=0",
    "lint:css:fix": "stylelint -c ./src/shared/configs/stylelint.config.mjs \"src/**/*.{css,js,jsx,ts,tsx}\" --fix --max-warnings=0"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@types/node": "^24.10.1",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-tsdoc": "^0.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "stylelint-config-tailwindcss": "^1.0.0",
    "stylelint-order": "^7.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
